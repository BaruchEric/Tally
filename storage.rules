rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isLedgerMember(ledgerId) {
      return signedIn()
        && request.auth.uid in firestore.get(/databases/(default)/documents/ledgers/$(ledgerId)).data.memberUids;
    }

    match /avatars/{uid}/{fileName} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid && request.resource.size < 5 * 1024 * 1024;
    }

    match /receipts/{ledgerId}/{entryId}/{fileName} {
      allow read: if isLedgerMember(ledgerId);
      allow write: if isLedgerMember(ledgerId) && request.resource.size < 10 * 1024 * 1024;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
