rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ledgerPath(ledgerId) {
      return /databases/$(database)/documents/ledgers/$(ledgerId);
    }

    function ledger(ledgerId) {
      return get(ledgerPath(ledgerId));
    }

    function isLedgerMember(ledgerId) {
      return signedIn() && request.auth.uid in ledger(ledgerId).data.memberUids;
    }

    function isLedgerOwner(ledgerId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/ledgers/$(ledgerId)/members/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/ledgers/$(ledgerId)/members/$(request.auth.uid)).data.role == "owner";
    }

    function canEditLedger(ledgerId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/ledgers/$(ledgerId)/members/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/ledgers/$(ledgerId)/members/$(request.auth.uid)).data.role in ["owner", "editor"];
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if false;

      match /private/{document=**} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }

    match /ledgers/{ledgerId} {
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.auth.uid in request.resource.data.memberUids;
      allow read: if isLedgerMember(ledgerId);
      allow update: if isLedgerOwner(ledgerId)
        || (canEditLedger(ledgerId)
          && request.resource.data.diff(resource.data).changedKeys().hasOnly(["name", "updatedAt", "archivedAt"]));
      allow delete: if false;

      match /members/{uid} {
        allow read: if isLedgerMember(ledgerId);
        allow create: if isLedgerOwner(ledgerId) || (signedIn() && request.auth.uid == uid);
        allow update, delete: if isLedgerOwner(ledgerId);
      }

      match /entries/{entryId} {
        allow read: if isLedgerMember(ledgerId);
        allow create: if canEditLedger(ledgerId)
          && request.resource.data.createdBy == request.auth.uid;
        allow update: if canEditLedger(ledgerId)
          && (resource.data.createdBy == request.auth.uid || isLedgerOwner(ledgerId));
        allow delete: if false;
      }

      match /balances/{uid} {
        allow read: if isLedgerMember(ledgerId);
        allow write: if false;
      }

      match /audit/{auditId} {
        allow read: if isLedgerMember(ledgerId);
        allow create, update, delete: if false;
      }
    }

    match /invites/{inviteId} {
      allow create: if signedIn()
        && isLedgerOwner(request.resource.data.ledgerId);
      allow read: if signedIn()
        && (resource.data.invitedBy == request.auth.uid
          || resource.data.email == request.auth.token.email.lower()
          || isLedgerMember(resource.data.ledgerId));
      allow update: if signedIn()
        && resource.data.email == request.auth.token.email.lower()
        && resource.data.status == "pending"
        && request.resource.data.status in ["accepted", "declined"]
        && request.resource.data.acceptedBy == request.auth.uid
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(["status", "acceptedBy", "acceptedAt"]);
      allow delete: if false;
    }

    match /fx/{day} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
